#!/bin/sh
# pre-push — file-level consistency checks before push
#
# File groups (edit A → must also edit B):
#   README.md ↔ README.zh.md
#   PLAN.md → policy-gateway/README.md → build.sh → docs/CROSS_COMPILE.md
#   Cargo.toml → vm/Cargo.toml
#   cli/src/main.rs → cli/pg.js
#   worker/index.ts → wrangler.toml
#   permissions.rs → docs/USER_GUIDE.md
#   portal.rs → docs/MODULES.md
#   vm-mod/main.rs → docs/MODULE_GUIDE.md
#   deploy/cli-registry.example.toml → cli/src/main.rs (registry format)

SENSITIVE="root-key.pem manager-token.txt seed.json .env id_ed25519 *.key *.p12"

check_group() {
    local trigger="$1" required="$2"
    if echo "$CHANGED" | grep -q "$trigger"; then
        if ! echo "$CHANGED" | grep -q "$required"; then
            echo "⚠️  $trigger changed without $required — consider updating"
        fi
    fi
}

while read local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        */main)
            echo "⚠️  main is protected. Use phaseX branch."
            [ -z "$SKIP_MAIN_CHECK" ] && exit 1
            ;;
    esac
done

CHANGED=$(git diff --cached --name-only)

# Sensitive file check
for p in $SENSITIVE; do
    if echo "$CHANGED" | grep -qi "$p"; then
        echo "❌ Sensitive file '$p' in commit — rejected"
        exit 1
    fi
done

# Version consistency
PG_VER=$(grep "^version" policy-gateway/Cargo.toml | head -1 | cut -d'"' -f2)
VM_VER=$(grep "^version" policy-gateway/vm/Cargo.toml 2>/dev/null | head -1 | cut -d'"' -f2)
VMOD_VER=$(grep "^version" policy-gateway/vm-mod/Cargo.toml 2>/dev/null | head -1 | cut -d'"' -f2)
if [ "$PG_VER" != "$VM_VER" ] || [ "$PG_VER" != "$VMOD_VER" ]; then
    echo "❌ Version mismatch: core=$PG_VER vm=$VM_VER vm-mod=$VMOD_VER"
    exit 1
fi

# Auto cargo check on source changes
if echo "$CHANGED" | grep -qE "policy-gateway/src/|*.rs|Cargo.toml|Cargo.lock"; then
    echo "🔨  Source changed — running cargo check..."
    cd policy-gateway && cargo check 2>&1 | tail -3
    if [ $? -ne 0 ]; then echo "❌ cargo check failed"; exit 1; fi
    cd ..
fi

# Auto test on test changes
if echo "$CHANGED" | grep -qE "src/|test/"; then
    echo "🧪  Tests changed — running cargo test..."
    cd policy-gateway && cargo test 2>&1 | grep "test result"
    if [ $? -ne 0 ]; then echo "❌ cargo test failed"; exit 1; fi
    cd ..
fi

# File association checks
check_group "README.md" "README.zh.md"
check_group "PLAN.md" "policy-gateway/README.md"
check_group "policy-gateway/README.md" "policy-gateway/build.sh"
check_group "policy-gateway/build.sh" "policy-gateway/docs/CROSS_COMPILE.md"
check_group "policy-gateway/docs/CROSS_COMPILE.md" "policy-gateway/build.sh"
check_group "policy-gateway/Cargo.toml" "policy-gateway/vm/Cargo.toml"
check_group "cli/src/main.rs" "cli/pg.js"
check_group "worker/vm-worker/index.ts" "worker/vm-worker/wrangler.toml"
check_group "src/api/permissions.rs" "policy-gateway/docs/USER_GUIDE.md"
check_group "src/modules/portal.rs" "policy-gateway/docs/MODULES.md"
check_group "vm-mod/src/main.rs" "policy-gateway/docs/MODULE_GUIDE.md"
check_group "deploy/cli-registry.example.toml" "cli/src/main.rs"

# Firewall rule change warning
if echo "$CHANGED" | grep -qE "nft\.rs|nftables|firewall|pg_nat"; then
    echo "⚠️  Firewall rules changed — verify on router before deploying"
fi

echo "✅  pre-push checks passed"
exit 0
